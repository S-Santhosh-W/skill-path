# Local runtime values; production values must be set as hosting environment secrets.
AI_MODE=mock
AI_BASE_URL=
AI_API_KEY=
# Optional browser-public Google Maps Embed key. Restrict to your site hostname and Maps Embed API.
GOOGLE_MAPS_EMBED_KEY=
# Reserved external identity configuration. Not connected in the Sites-hosted edition.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Server-side discovery gateway (optional); POST receives {moduleId,topic,search,language}.
RESOURCE_SEARCH_URL=
RESOURCE_SEARCH_KEY=
# First administrators are provisioned by the site owner, never by the client.
ADMIN_USER_IDS=
